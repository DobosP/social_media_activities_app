# Local native Go example; provider/account/media activation remains opt-in.
# Django reference settings live below for offline tests only; see docs/NATIVE_SERVER.md.
DJANGO_DEBUG=True
SITE_BASE_URL=http://127.0.0.1:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=synthetic-local-fixture-secret-00000001
DATABASE_URL=postgres://app:app@localhost:5432/app
# Native bounded PostgreSQL pool (one connection is reserved for live delivery).
DB_POOL_ENABLED=True
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=4
# DB_POOL_TIMEOUT=10  # Offline Python oracle only; native rejects this retired queue-timeout knob.

# Ingestion
OVERPASS_URL=https://overpass-api.de/api/interpreter
INGEST_DEFAULT_CITY=Cluj-Napoca
INGEST_USER_AGENT=social-activities-app/0.1 (nonprofit; contact: you@example.org)

# --- RO-EDU data platform (romania_scraper) — places & events source ---
# Base URL + key for the read-only data API. The dev key 'social-app-dev' is the
# redistributable-only key (server is fail-closed on license; no tdm_exception).
ROEDU_API_URL=http://localhost:8077
ROEDU_API_KEY=social-app-dev
# REQUIRED to use --source=roedu. The 'roedu' adapter is NOT built into ingest_places;
# it is loaded via this pluggable registry (settings.INGESTION_EXTRA_ADAPTERS, a JSON
# map of {"<source-name>": "dotted.path.AdapterClass"}). Without this line,
# `ingest_places --source=roedu` fails with: CommandError: Unknown source: roedu.
INGESTION_EXTRA_ADAPTERS={"roedu": "apps.ingestion.sources.ro_scraper.RomaniaScraperAdapter"}

# --- Production integrations (config.settings.prod; all optional in dev) ---
# EUDI age verification (D2): turn the sandbox off and trust the live EU issuer(s).
# EUDI_SANDBOX=False
# EUDI_TRUSTED_ISSUERS={"https://issuer.example.eu":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}

# Private media: an approved EU-native, private S3 bucket (company residency policy).
# MEDIA_STORAGE_BACKEND=apps.media.storage.S3StorageBackend
# MEDIA_S3_BUCKET=
# MEDIA_S3_ENDPOINT_URL=        # chosen EU-native provider HTTPS endpoint
# MEDIA_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Content-safety scanning (uploads are FAIL-CLOSED in prod: disabled until an *effective*
# scanner is configured). Pick ONE path to enable photo uploads:
#  (a) a hash blocklist — inline and/or a newline-delimited file of known-bad SHA-256s:
# MEDIA_CSAM_HASH_BLOCKLIST=<hash1>,<hash2>
# MEDIA_CSAM_HASH_BLOCKLIST_FILE=/secrets/csam-hashes.txt
#  (b) a managed matcher (PhotoDNA/Thorn-style HTTPS endpoint):
# MEDIA_IMAGE_SCANNER=apps.media.scanning.ManagedScanner
# MEDIA_SCANNER_ENDPOINT=https://scanner.example/scan
# MEDIA_SCANNER_API_KEY=
# Decompression-bomb ceiling (header-declared pixels rejected before decode):
# MEDIA_MAX_IMAGE_PIXELS=30000000

# Donations via Stripe Checkout (no card data touched).
# DONATIONS_PROVIDER=apps.donations.providers.StripePaymentProvider
# STRIPE_SECRET_KEY=
# DONATIONS_SUCCESS_URL=https://your-host/thanks
# DONATIONS_CANCEL_URL=https://your-host/donate
# Donation-webhook auth (FAIL-CLOSED: with neither set, webhook callbacks are rejected).
# DONATIONS_WEBHOOK_SECRET=        # shared secret sent in X-Webhook-Secret
# STRIPE_WEBHOOK_SECRET=           # Stripe signing secret (verifies Stripe-Signature)

# Shared native identity core; credentials are delivered through the SOPS bundle.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FACEBOOK_OAUTH_CLIENT_ID=
# FACEBOOK_OAUTH_CLIENT_SECRET=
# FACEBOOK_API_VERSION=            # explicit provider version, e.g. vNN.0
# MEDIA_EU_RESIDENCY_VERIFIED=False
# MEDIA_PRIVATE_BUCKET_VERIFIED=False
# TRUSTED_PROXY_CIDRS=             # exact ingress peer CIDRs, never arbitrary XFF
# Source nondefault policies that lack native support stop startup by setting NAME.
# REDIS_URL/Sentry integration are not silently accepted; see native configuration guide.
