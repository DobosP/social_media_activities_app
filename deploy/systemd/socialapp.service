[Unit]
Description=Social Activities app (native Go REST, HTML and WebSocket chat)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=app
Group=app
WorkingDirectory=/home/app/social_media_activities_app
EnvironmentFile=/home/app/social_media_activities_app/.env
# A reviewed release artifact includes the native binary, templates and hashed SPA assets.
ExecStartPre=/usr/local/bin/social-server --migrate-only
ExecStart=/usr/local/bin/social-server --listen 127.0.0.1:8000 --site-root /home/app/social_media_activities_app --static-dir /home/app/social_media_activities_app/static --media-scratch /home/app/social_media_activities_app/var/media-work
Restart=always
RestartSec=3
# Hardening: the service needs only its own tree + the loopback DB.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/app/social_media_activities_app/var
PrivateTmp=true

[Install]
WantedBy=multi-user.target
