{{define "notification-inbox"}}<!doctype html>
<html lang="{{.Shell.Language}}" data-theme="{{.Shell.Theme}}" data-text="{{.Shell.Text}}" data-motion="{{.Shell.Motion}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{index .Copy "Notifications"}} · {{.Shell.SiteName}}</title>
<link rel="canonical" href="/notifications/">
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/css/base.css">
<link rel="stylesheet" href="/static/css/notification-inbox-native.css">
</head>
<body class="notification-inbox-native">
<a class="skip-link" href="#main">{{index .Copy "Skip to main content"}}</a>
<header class="site-header"><div class="container nav-wrap">
<a class="brand" href="/"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="currentColor"></circle></svg> {{index .Copy "Activities"}}</a>
<input type="checkbox" id="nav-toggle" class="nav-toggle-cb"><label for="nav-toggle" class="nav-toggle"><span aria-hidden="true">☰</span> {{index .Copy "Menu"}}</label>
<nav class="nav" aria-label="{{index .Copy "Primary"}}">{{range .Shell.Navigation}}<a class="nav-link" href="{{.URL}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav>
<details class="nav-menu nav-end"><summary>{{.Shell.DisplayName}}</summary><div class="nav-panel">
{{range .AccountLinks}}<a href="{{.URL}}">{{.Label}}</a>{{end}}
<form method="post" action="/logout/" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="linkbtn" type="submit">{{index .Copy "Log out"}}</button></form>
</div></details>
</div></header>
<main class="container" id="main" tabindex="-1">
<header class="notification-inbox-heading"><h1>{{index .Copy "Notifications"}}</h1>
<div class="row notification-inbox-actions">
{{if .Rows}}<form method="post" action="/notifications/read-all/" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="btn btn-sm btn-secondary" type="submit">{{index .Copy "Mark all read"}}</button></form>{{end}}
<a class="btn btn-sm btn-secondary" href="/notifications/preferences/">{{index .Copy "Notification settings"}}</a>
</div></header>
{{if .Shell.Messages}}<ul class="messages">{{range .Shell.Messages}}<li class="msg error"><span role="alert">{{.}}</span></li>{{end}}</ul>{{end}}
{{if .Rows}}<div class="grid notification-inbox-list">
{{range .Rows}}<article class="card{{if .Unread}} card-accent{{end}}" data-notification-row="" data-notification-unread="{{.Unread}}">
<h2 class="notification-inbox-title" data-notification-title="">{{.Title}}</h2>{{if .Unread}} <span class="tag">{{index $.Copy "new"}}</span>{{end}}
{{if .Body}}<p data-notification-body="">{{.Body}}</p>{{end}}
{{if .Why}}<p class="muted"><small data-notification-why="">{{.Why}}</small></p>{{end}}
<p class="muted"><time data-notification-time="" datetime="{{.ISOTime}}">{{.When}}</time>{{if .URL}} · <a data-notification-link="" href="{{.URL}}">{{index $.Copy "view"}}</a>{{end}}</p>
</article>{{end}}
</div>{{else}}<p class="muted" id="notification-inbox-empty">{{index .Copy "No notifications yet."}}</p>{{end}}
</main>
<footer class="site-footer"><div class="container">
<p><strong>{{index .Copy "Demo environment: do not enter real personal data."}}</strong></p>
<nav class="footer-links" aria-label="{{index .Copy "Privacy"}}">{{range .Shell.Footer}}<a href="{{.URL}}">{{.Label}}</a> {{end}}</nav>
<form method="post" action="/i18n/setlang/" class="inline lang-switch">
<input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><input type="hidden" name="next" value="/notifications/">
<label for="notification-inbox-language">{{index .Copy "Language"}}</label><select id="notification-inbox-language" name="language" data-auto-submit><option value="en"{{if .Shell.English}} selected{{end}}>English</option><option value="ro"{{if not .Shell.English}} selected{{end}}>Română</option></select>
<button class="linkbtn" type="submit">{{index .Copy "Set language"}}</button>
</form>
</div></footer>
<script nonce="{{.Nonce}}" src="/static/js/hovercard.js" defer></script>
<script nonce="{{.Nonce}}" id="site-js" src="/static/js/site.js" defer data-meetups-owner="{{.PublicID}}"></script>
</body></html>{{end}}
