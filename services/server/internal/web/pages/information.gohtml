{{define "information"}}<!doctype html>
<html lang="{{.Shell.Language}}" data-theme="{{.Shell.Theme}}" data-text="{{.Shell.Text}}" data-motion="{{.Shell.Motion}}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
{{if .GoogleVerification}}<meta name="google-site-verification" content="{{.GoogleVerification}}">{{end}}{{if .BingVerification}}<meta name="msvalidate.01" content="{{.BingVerification}}">{{end}}
<title>{{.Title}}</title><meta name="description" content="{{index .Copy "A nonprofit, text-first way to meet up in person for real group activities at real places. First city: Cluj-Napoca."}}"><meta name="robots" content="index, follow"><link rel="canonical" href="{{.Shell.Canonical}}">
<meta property="og:site_name" content="{{.Shell.SiteName}}"><meta property="og:type" content="website"><meta property="og:title" content="{{index .Copy "Social Activities"}}"><meta property="og:description" content="{{index .Copy "A nonprofit, text-first way to meet up in person for real group activities at real places."}}"><meta property="og:url" content="{{.Shell.Canonical}}"><meta property="og:locale" content="{{.OGLocale}}"><meta name="twitter:card" content="summary">
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/static/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/css/base.css"><link rel="stylesheet" href="/static/css/information-native.css"><link rel="stylesheet" href="/static/css/completion-accessibility.css"></head>
<body class="information-native{{if .Authenticated}} has-tabbar{{end}}">
<a class="skip-link" href="#main">{{index .Copy "Skip to main content"}}</a>
<header class="site-header"><div class="container nav-wrap"><a class="brand" href="/"><svg class="native-brand-mark" viewBox="0 0 8 8" width="8" height="8" aria-hidden="true" focusable="false"><circle cx="4" cy="4" r="3" fill="currentColor"/></svg> {{index .Copy "Activities"}}</a>
<input type="checkbox" id="nav-toggle" class="nav-toggle-cb"><label for="nav-toggle" class="nav-toggle"><span aria-hidden="true">☰</span> {{index .Copy "Menu"}}</label>
<nav class="nav" aria-label="{{index .Copy "Primary"}}">{{range .Shell.Navigation}}<a class="nav-link" href="{{.URL}}">{{.Label}}</a>{{end}}
<details class="nav-menu"><summary>{{index .Copy "Discover"}}</summary><div class="nav-panel">{{range .Navigation}}<a href="{{.URL}}">{{.Label}}</a>{{end}}</div></details><span class="spacer"></span>
{{if .Authenticated}}<a class="nav-link" href="/notifications/">{{index .Copy "Notifications"}}{{if .Unread}} <span class="pill">{{.Unread}}</span>{{end}}</a><a class="nav-link" href="/messages/">{{index .Copy "Messages"}}</a>
<details class="nav-menu nav-end"><summary>{{if .Avatar}}<img class="avatar nav-avatar" src="{{.Avatar}}" width="26" height="26" alt="">{{end}}<span class="nav-username">{{.Shell.DisplayName}}</span></summary><div class="nav-panel">{{range .AccountLinks}}<a href="{{.URL}}">{{.Label}}</a>{{end}}<div class="sep"></div><form method="post" action="/logout/" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="linkbtn" type="submit">{{index .Copy "Log out"}}</button></form></div></details>
{{else}}<a class="nav-link nav-end" href="/login/">{{index .Copy "Log in"}}</a><a class="nav-link nav-cta" href="/register/">{{index .Copy "Sign up"}}</a>{{end}}</nav></div></header>
<main class="container information-main" id="main" tabindex="-1">
{{if .Messages}}<ul class="messages">{{range .Messages}}<li class="msg {{.Tags}}"><span role="status">{{.Text}}</span></li>{{end}}</ul>{{end}}
{{if eq .Kind "donate"}}
<h1>{{index .Copy "Support the project"}}</h1><p class="lead information-lead">{{.Lead}}</p>
<form method="post" class="card information-donation-form"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}">
{{if .Form.Error}}<ul class="errorlist"><li>{{.Form.Error}}</li></ul>{{end}}
<p><label for="id_amount">Amount (EUR):</label> <input type="number" name="amount" value="{{.Form.Amount}}" min="1" step="0.01" required id="id_amount"></p>
<p><label for="id_campaign">Direct your gift to:</label> <select name="campaign" id="id_campaign"><option value="">General fund (where it's needed most)</option>{{range .Form.Choices}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></p>
<button class="btn" type="submit">{{index .Copy "Donate"}}</button></form>
{{if .Anchors}}<section class="card" aria-labelledby="anchors-h"><h2 id="anchors-h">{{index .Copy "What a gift makes possible"}}</h2><p class="muted">{{index .Copy "A few illustrative examples of what donations fund &mdash; not a target, and not tied to any single gift."}}</p><ul>{{range .Anchors}}<li><strong>{{.Currency}} {{.Money}}</strong> — {{.Label}}</li>{{end}}</ul></section>{{end}}
<p class="muted">{{index .Copy "You'll be taken to a secure checkout &mdash; no card data ever touches this app."}}</p><p class="muted"><a href="/transparency/">{{index .Copy "See where donations go"}}</a> · <a href="/campaigns/">{{index .Copy "Active campaigns"}}</a></p>
{{else if eq .Kind "transparency"}}
<h1>{{.Title}}</h1><p class="muted information-lead">{{index .Copy "We're funded only by donations &mdash; no ads, no tracking. Figures are shown in EUR, entered by our team and updated periodically."}}</p>
<section class="card"><h2>{{index .Copy "Donations received"}}</h2><p><strong>{{.RaisedLabel}}</strong> {{index .Copy "from completed donations."}}</p></section>
<section class="card"><h2>{{index .Copy "Spending by category"}}</h2>{{if .Spend}}<ul class="members">{{range .Spend}}<li>{{.Category}} — <strong>{{.Label}}</strong></li>{{end}}</ul><p class="muted">{{.SpendingLabel}}</p>{{else}}<p class="muted">{{index .Copy "No spending has been published yet."}}</p>{{end}}</section>
{{if .InKind}}<section class="card"><h2>{{index .Copy "In-kind contributions"}}</h2><p class="muted">{{index .Copy "Non-cash support from partners and the community &mdash; shown separately, not added to the cash figures above."}}</p><ul class="members">{{range .InKind}}<li>{{.Category}} — {{if .HasQuantity}}<strong>{{.Quantity}} {{.Unit}}</strong>{{end}}{{if .HasMoney}}{{if .HasQuantity}} · {{end}}<strong>{{.Estimate}}</strong>{{end}}</li>{{end}}</ul></section>{{end}}
{{if .Outcomes}}<section class="card"><h2>{{index .Copy "What this made possible"}}</h2><p class="muted">{{index .Copy "Staff-written notes on what the platform's spend and partner backing produced &mdash; in words, never a counter."}}</p><ul class="members">{{range .Outcomes}}<li><strong>{{.Headline}}</strong>{{if .Period}} <span class="muted">({{.Period}})</span>{{end}}{{if .Detail}}<br><span class="muted">{{.Detail}}</span>{{end}}{{if .Partner}}<br><span class="muted">{{.Partner}}</span>{{end}}</li>{{end}}</ul></section>{{end}}<p><a class="btn" href="/donate/">{{index .Copy "Support the platform"}}</a></p>
{{else if eq .Kind "campaigns"}}
<h1>{{.Title}}</h1><p class="muted information-lead">{{index .Copy "Specific things your donation can support. Earmark a gift to one, or give to the general fund. Figures shown in EUR."}}</p>
<div class="information-campaigns">{{range .Campaigns}}<section class="card information-campaign"><h2>{{.Title}}</h2>{{template "information-paragraphs" .Description}}
<div role="progressbar" aria-valuenow="{{.Percent}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{.MeterLabel}}" class="meter"><svg class="campaign-meter-fill" aria-hidden="true" focusable="false" viewBox="0 0 100 1" preserveAspectRatio="none"><rect width="{{.Percent}}%" height="1"></rect></svg></div><p class="muted">{{.RaisedLabel}}</p>
{{if .Partner}}<p class="muted activity-meta-note">{{index $.Copy "In partnership with"}} {{if .PartnerURL}}<a href="{{.PartnerURL}}" rel="noopener noreferrer" target="_blank">{{.Partner}}</a>{{else}}{{.Partner}}{{end}}{{if .PartnerBlurb}} — {{.PartnerBlurb}}{{end}}</p>{{end}}<a class="btn btn-sm" href="{{.DonateURL}}">{{index $.Copy "Donate to this campaign"}}</a></section>{{else}}<p class="muted">{{index .Copy "No active campaigns right now."}} <a href="/donate/">{{index .Copy "Support the general fund"}}</a>.</p>{{end}}</div>
{{if .Completed}}<h2>{{index .Copy "Completed campaigns"}}</h2><p class="muted">{{index .Copy "What earmarked gifts have funded — a plain record, no targets or scores."}}</p>{{range .Completed}}<section class="card information-closeout"><h3>{{.Title}}</h3>{{template "information-paragraphs" .Outcome}}<p class="muted activity-meta-note">{{.RaisedLabel}}</p>{{if .Spend}}<p class="muted activity-meta-note">{{index $.Copy "Where it went:"}}</p><ul class="members">{{range .Spend}}<li>{{.Category}} — {{.Money}} {{.Currency}}{{if .Period}} ({{.Period}}){{end}}</li>{{end}}</ul>{{end}}</section>{{end}}{{end}}
{{else if eq .Kind "partners"}}
<h1>{{.Title}}</h1><p class="muted information-lead">{{index .Copy "Libraries, schools, NGOs, civic bodies and local businesses that steward real venues. This is an acknowledgement &mdash; not advertising. Partners are staff-verified and never pay for placement; a partner venue ranks exactly like every other place."}}</p>
<div class="information-partners">{{range .Partners}}<section class="card"><h2>{{.Name}}</h2><span class="tag">{{.Kind}}</span>{{if .Blurb}}<p>{{.Blurb}}</p>{{end}}{{if .Steward}}<p class="muted">{{.Steward}}</p>{{end}}{{if .Website}}<p class="muted"><a href="{{.Website}}" rel="noopener noreferrer" target="_blank">{{index $.Copy "Website &rarr;"}}</a></p>{{end}}</section>{{else}}<p class="muted">{{index .Copy "No civic partners listed yet."}}</p>{{end}}</div>
{{else if eq .Kind "my_donations"}}
<h1>{{.Title}}</h1><nav class="tabs" aria-label="{{index .Copy "Account"}}">{{range .Shell.AccountTabs}}<a href="{{.URL}}"{{if .Current}} class="is-active" aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav><p class="muted">{{index .Copy "Your own donation receipts. We never store card or payment details &mdash; only an amount, a date and an opaque reference."}}</p>
{{range .Donations}}<article class="card information-receipt"><strong>{{.Money}} {{.Currency}}</strong> <span class="tag">{{.Status}}</span>{{if .Recurring}} <span class="tag">{{index $.Copy "recurring"}}</span>{{end}}{{if .Campaign}} <span class="tag">{{.Campaign}}</span>{{end}}<p class="muted">{{.When}}{{if .Reference}} · {{.Reference}}{{end}}</p></article>{{else}}<p class="muted">{{index .Copy "You have no donations yet."}} <a href="/donate/">{{index .Copy "Make one?"}}</a></p>{{end}}
{{end}}</main>
{{if .Authenticated}}<nav class="tabbar" aria-label="{{index .Copy "Menu"}}"><a href="/">{{index .Copy "Home"}}</a><a href="/activities/">{{index .Copy "Browse"}}</a><a class="tab-cta" href="/activities/new/">{{index .Copy "Organize"}}</a><a href="/messages/">Chat</a><a href="/you/">{{index .Copy "Profile"}}</a></nav>{{end}}
<footer class="site-footer"><div class="container"><p>{{.FooterIntro}} <strong>{{index .Copy "Demo environment: do not enter real personal data."}}</strong></p><nav class="footer-links" aria-label="{{index .Copy "Privacy"}}">{{range .Shell.Footer}}<a href="{{.URL}}">{{.Label}}</a> {{end}}</nav>
<form method="post" action="/i18n/setlang/" class="inline lang-switch"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><input type="hidden" name="next" value="{{.LanguageNext}}"><label for="information-language">{{index .Copy "Language"}}</label><select id="information-language" name="language" data-auto-submit><option value="en"{{if .Shell.English}} selected{{end}}>English</option><option value="ro"{{if not .Shell.English}} selected{{end}}>Română</option></select><noscript><button class="linkbtn" type="submit">{{index .Copy "Set language"}}</button></noscript></form></div></footer>
<script nonce="{{.Nonce}}" src="/static/js/hovercard.js" defer></script><script nonce="{{.Nonce}}" id="site-js" src="/static/js/site.js" defer{{if .Authenticated}} data-meetups-owner="{{.PublicID}}"{{end}}></script></body></html>{{end}}
{{define "information-paragraphs"}}{{range .}}<p>{{range $i, $line := .}}{{if $i}}<br>{{end}}{{$line}}{{end}}</p>{{end}}{{end}}
