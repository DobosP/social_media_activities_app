{{define "notification-preferences"}}<!doctype html>
<html lang="{{.Shell.Language}}" data-theme="{{.Shell.Theme}}" data-text="{{.Shell.Text}}" data-motion="{{.Shell.Motion}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{index .Copy "Notification settings"}} · {{.Shell.SiteName}}</title>
<link rel="canonical" href="/notifications/preferences/">
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/css/base.css">
<link rel="stylesheet" href="/static/css/notification-preferences-native.css">
</head>
<body class="notification-preferences-page">
<a class="skip-link" href="#main">{{index .Copy "Skip to main content"}}</a>
<header class="site-header"><div class="container nav-wrap">
<a class="brand" href="/"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="currentColor"></circle></svg> {{index .Copy "Activities"}}</a>
<input type="checkbox" id="nav-toggle" class="nav-toggle-cb"><label for="nav-toggle" class="nav-toggle"><span aria-hidden="true">☰</span> {{index .Copy "Menu"}}</label>
<nav class="nav" aria-label="{{index .Copy "Primary"}}">{{range .Shell.Navigation}}<a class="nav-link" href="{{.URL}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav>
<details class="nav-menu nav-end"><summary>{{.Shell.DisplayName}}</summary><div class="nav-panel">
{{range .AccountLinks}}<a href="{{.URL}}">{{.Label}}</a>{{end}}
<form method="post" action="/logout/" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="linkbtn" type="submit">{{index .Copy "Log out"}}</button></form>
</div></details>
</div></header>
<main class="container" id="main" tabindex="-1">
<p class="muted"><a href="/notifications/">← {{index .Copy "Notifications"}}</a></p>
<h1>{{index .Copy "Notification settings"}}</h1>
<p class="muted" id="notification-preferences-intro">{{.Intro}}</p>
{{if .Shell.Messages}}<ul class="messages">{{range .Shell.Messages}}<li class="msg error"><span role="alert">{{.}}</span></li>{{end}}</ul>{{end}}
<form method="post" action="/notifications/preferences/" class="card notification-preferences-form" aria-describedby="notification-preferences-intro">
<input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}">
<fieldset><legend class="visually-hidden">{{index .Copy "Notification settings"}}</legend>
{{range .Rows}}<label class="row preference-choice" for="notification-kind-{{.Kind}}">
<input type="checkbox" id="notification-kind-{{.Kind}}" name="muted" value="{{.Kind}}" aria-describedby="notification-kind-{{.Kind}}-reason{{if .Arrival}} notification-arrival-warning{{end}}"{{if .Muted}} checked{{end}}>
<span><strong>{{.Label}}</strong><br><span class="muted u-text-sm" id="notification-kind-{{.Kind}}-reason">{{.Reason}}</span>{{if .Arrival}}<br><span class="muted u-text-sm" id="notification-arrival-warning">{{$.ArrivalWarning}}</span>{{end}}</span>
</label>{{end}}
</fieldset>
<button class="btn preference-submit" type="submit">{{index .Copy "Save settings"}}</button>
</form>
</main>
<footer class="site-footer"><div class="container">
<p><strong>{{index .Copy "Demo environment: do not enter real personal data."}}</strong></p>
<nav class="footer-links" aria-label="{{index .Copy "Privacy"}}">{{range .Shell.Footer}}<a href="{{.URL}}">{{.Label}}</a> {{end}}</nav>
<form method="post" action="/i18n/setlang/" class="inline lang-switch">
<input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><input type="hidden" name="next" value="/notifications/preferences/">
<label for="notification-language">{{index .Copy "Language"}}</label><select id="notification-language" name="language" data-auto-submit><option value="en"{{if .Shell.English}} selected{{end}}>English</option><option value="ro"{{if not .Shell.English}} selected{{end}}>Română</option></select>
<button class="linkbtn" type="submit">{{index .Copy "Set language"}}</button>
</form>
</div></footer>
<script nonce="{{.Nonce}}" src="/static/js/hovercard.js" defer></script>
<script nonce="{{.Nonce}}" id="site-js" src="/static/js/site.js" defer data-meetups-owner="{{.PublicID}}"></script>
</body></html>{{end}}
