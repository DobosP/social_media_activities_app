{{define "public-place-detail"}}{{$p := .Place}}
<nav class="breadcrumbs" aria-label="{{index .Copy "Breadcrumb"}}"><ol><li><a href="/">{{index .Copy "Home"}}</a></li><li><a href="/places/list/">{{index .Copy "Places"}}</a></li><li><span aria-current="page">{{$p.Title}}</span></li></ol></nav>
{{if $p.Pending}}<div class="banner">{{$p.Pending}}</div>{{end}}
<section class="place-hero" aria-labelledby="place-title">
<figure class="place-cover">{{if $p.Visual.URL}}<img src="{{$p.Visual.URL}}" alt="{{$p.Visual.Alt}}">{{if $p.Visual.Attribution}}<figcaption class="place-cover-attribution">{{if $p.Visual.SourceURL}}<a href="{{$p.Visual.SourceURL}}" rel="noopener noreferrer" target="_blank">{{$p.Visual.Attribution}}</a>{{else}}{{$p.Visual.Attribution}}{{end}}{{if $p.Visual.License}} · {{$p.Visual.License}}{{end}}</figcaption>{{end}}{{else}}<div class="place-cover-accent" aria-hidden="true"><img src="{{$p.Visual.AccentURL}}" alt="" width="320" height="120"></div>{{end}}</figure>
<div class="place-hero-body"><h1 id="place-title">{{$p.Heading}}</h1>{{if $p.LocalPOC}}<p><span class="tag fact--false">LOCAL POC — not cleared for publication</span></p>{{end}}
{{if $p.Categories}}<div class="place-chip-row" role="group" aria-label="{{index .Copy "Activity categories"}}">{{range $p.Categories}}<span class="map-chip place-chip">{{.}}</span>{{end}}</div>{{end}}
<p class="place-hero-badges">{{if $p.OpenLabel}}<span class="tag {{$p.OpenClass}}">{{$p.OpenLabel}}</span>{{end}}{{if eq $p.AccessClass "fact--true"}} <span class="tag fact--true">{{$p.AccessLabel}}</span>{{end}}</p>
<p class="muted">{{$p.Address}}{{if $p.Country}} {{$p.Country}}{{end}}</p>{{if $p.Website}}<p><a class="btn btn--light" href="{{$p.Website}}" rel="noopener noreferrer" target="_blank">{{index .Copy "Official website"}} →</a></p>{{end}}
{{if $p.Official}}<p><span class="tag fact--true">{{index .Copy "Official venue page"}} ✓</span> <span class="muted">{{$p.OfficialNote}}</span></p>{{end}}
{{with $p.Partner}}<p class="muted">{{index $.Copy "In partnership with"}} {{if .URL}}<a href="{{.URL}}" rel="noopener noreferrer" target="_blank">{{.Name}}</a>{{else}}{{.Name}}{{end}} <small>({{.Kind}})</small></p>{{if .Blurb}}<p class="muted partner-blurb">{{.Blurb}}</p>{{end}}{{end}}
</div></section>
{{if $p.OfficialClaim}}<details class="place-official-image"><summary>{{index .Copy "Official image"}}</summary><p class="muted">{{index .Copy "One image, shown on the venue page. Uploads are scanned and EXIF-stripped; it replaces any cached Wikimedia image."}}</p>
<form method="post" action="{{$p.ImageURL}}" enctype="multipart/form-data"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}">{{template "public-place-image-fields" $p.ImageForm}}<button type="submit" class="btn">{{index .Copy "Upload image"}}</button></form>
{{if $p.HasCover}}<form method="post" action="{{$p.ImageURL}}"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><input type="hidden" name="remove" value="1"><button type="submit" class="btn btn--light">{{index .Copy "Remove the current image"}}</button></form>{{end}}</details>{{end}}
{{if .Signed}}
<p class="place-primary-cta"><a class="btn" href="{{$p.OrganizeURL}}">{{index .Copy "Organise an activity here"}}</a></p><h2>{{index .Copy "Upcoming here"}}</h2>
{{range $p.Meetups}}{{template "public-place-activity" .}}{{else}}<p class="muted">{{index .Copy "No upcoming activities here yet."}}</p>{{end}}
{{if $p.LocalMode}}<p class="muted">{{if $p.Past}}<a href="?">Upcoming events only</a>{{else}}<a href="?include_past=1">Include past events (LOCAL POC)</a>{{end}}</p>{{end}}
{{if $p.Events}}<h2>{{index .Copy "Events here"}}</h2>{{range $p.Events}}<div class="card"><h3><a href="{{.URL}}">{{.Title}}</a></h3>{{if .LocalPOC}}<p><span class="tag fact--false">LOCAL POC — not cleared for publication</span>{{if .Past}} <span class="tag">Past event</span>{{end}}</p>{{end}}<p class="muted">{{.When}}</p></div>{{end}}{{end}}
{{else}}<div class="banner">{{$p.LoginNote}}</div>{{end}}
<details class="place-section"><summary>{{index .Copy "Community facts"}}</summary>
{{if or $p.RecordedAccess $p.RecordedVenue}}<div class="place-recorded-facts"><h3>{{index .Copy "Recorded facts"}}</h3><ul class="members">{{range $p.RecordedAccess}}<li>{{.Label}}: <span class="tag {{.Class}}">{{.StateLabel}}</span></li>{{end}}{{range $p.RecordedVenue}}<li>{{.Label}}: <span class="tag {{.Class}}">{{.StateLabel}}</span></li>{{end}}</ul></div>{{end}}
<div class="card"><h2 class="u-mt-0">{{index .Copy "Activities here"}}</h2>{{if $p.Edges}}<ul class="members">{{range $p.Edges}}<li><span class="tag {{.Class}}">{{.Name}}</span> {{if .Confirmed}}<small class="muted">{{index $.Copy "community-confirmed"}}</small>{{else if .Disputed}}<small class="muted">{{index $.Copy "disputed &mdash; hidden from search (staff view)"}}</small>{{else}}<small class="muted">{{.Counts}}{{.Disputes}}</small>{{end}}
{{if $p.CanContribute}}<form method="post" action="{{.URL}}" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{$.Shell.CSRF}}"><button class="btn btn--light" name="vote" value="confirm"{{if eq .MyVote "confirm"}} disabled{{end}}>{{index $.Copy "Confirm"}}</button><button class="btn btn--light" name="vote" value="dispute"{{if eq .MyVote "dispute"}} disabled{{end}}>{{index $.Copy "Dispute"}}</button></form>{{end}}</li>{{end}}</ul>{{else}}<p class="muted">{{index .Copy "No activities recorded here yet."}}</p>{{end}}</div>
{{if $p.Brief}}<section class="card" aria-labelledby="place-brief-heading"><h2 id="place-brief-heading" class="u-mt-0">{{index .Copy "At a glance"}}</h2><dl class="brief">{{range $p.Brief}}<dt>{{.Label}}</dt><dd>{{.Sentence}}</dd>{{end}}</dl></section>{{end}}
<div class="card"><h2 class="u-mt-0">{{index .Copy "Accessibility"}}</h2>{{if $p.HasPreference}}<p><span class="{{$p.AccessClass}}">{{$p.AccessLabel}}</span></p>{{else}}<p class="muted">{{$p.AccessNote}}</p>{{end}}
<ul class="members">{{range $p.Access}}<li>{{.Label}}: <span class="tag {{.Class}}">{{.StateLabel}}</span></li>{{end}}</ul><p class="muted u-text-sm">{{index .Copy "From the venue's open data &mdash; we never claim a place is accessible when it isn't recorded."}}</p></div>
<div class="card"><h2 class="u-mt-0">{{index .Copy "What's at this venue"}}</h2>{{if $p.KidFacts}}<p><span class="tag fact--true">{{index .Copy "Has kid-friendly facilities"}}</span></p>{{end}}<ul class="members">{{range $p.Venue}}<li>{{.Label}}: <span class="tag {{.Class}}">{{.StateLabel}}</span>
{{if .FromMap}}<small class="muted">{{index $.Copy "from map data"}}</small>{{else}}<small class="muted">{{.Counts}}</small>{{if $p.CanContribute}}<form method="post" action="{{$p.FactURL}}" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{$.Shell.CSRF}}"><input type="hidden" name="fact_key" value="{{.Key}}"><button class="btn btn--light" name="value" value="yes"{{if .VotedYes}} disabled{{end}}>{{index $.Copy "Yes"}}</button><button class="btn btn--light" name="value" value="no"{{if .VotedNo}} disabled{{end}}>{{index $.Copy "No"}}</button></form>{{end}}{{end}}</li>{{end}}</ul><p class="muted u-text-sm">{{index .Copy "Map data first; otherwise members confirm. We never claim a fact that isn't recorded, and never show who voted."}}</p></div></details>
{{if $p.HasHours}}<details class="place-section"><summary>{{index .Copy "Hours"}}</summary><p class="muted u-text-sm">{{index .Copy "Posted:"}} <code>{{$p.PostedHours}}</code></p>{{if eq $p.OpenClass "fact--limited"}}<p class="muted activity-meta-note">{{index .Copy "Visitors reported the posted hours were wrong here."}}</p>{{end}}
{{if $p.CanContribute}}<form method="post" action="{{$p.HoursReportURL}}" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="btn btn--light" type="submit">{{index .Copy "Report: closed when it said open"}}</button></form>{{end}}{{if .Staff}}<form method="post" action="{{$p.HoursResetURL}}" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="btn btn--light" type="submit">{{index .Copy "Clear hours reports (staff)"}}</button></form>{{end}}</details>{{end}}
<details class="place-section"><summary>{{index .Copy "Data & corrections"}}</summary>{{if and .Signed (not $p.Official)}}<p class="muted"><a class="muted-link" href="{{$p.ClaimURL}}">{{index .Copy "Is this your venue? Claim it"}} →</a></p>{{end}}
{{if or $p.Credit.Attribution $p.Credit.License $p.Credit.URL}}<p class="muted activity-meta-note">{{index .Copy "Source credit:"}} {{$p.Credit.Attribution}}{{if $p.Credit.License}} · {{$p.Credit.License}}{{end}}{{if $p.Credit.URL}} · <a href="{{$p.Credit.URL}}" rel="noopener noreferrer" target="_blank">{{index .Copy "source record"}}</a>{{end}}</p>{{end}}
<div class="card"><h2 class="u-mt-0">{{index .Copy "Name &amp; address"}}</h2>{{if $p.Corrections}}<ul class="members">{{range $p.Corrections}}<li>{{.Label}} → <strong>{{.Value}}</strong> <small class="muted">{{.Counts}}</small>{{if and $p.CanContribute (not .Proposer)}}<form method="post" action="{{.URL}}" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{$.Shell.CSRF}}"><button class="btn btn--light"{{if .Confirmed}} disabled{{end}}>{{index $.Copy "Confirm"}}</button></form>{{end}}</li>{{end}}</ul>{{end}}
{{if $p.CanContribute}}<details><summary>{{index .Copy "Suggest a correction"}}</summary><form method="post" action="{{$p.CorrectionURL}}" class="stack"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><label>{{index .Copy "What's wrong?"}}<select name="field"><option value="name">{{index .Copy "Name"}}</option><option value="address">{{index .Copy "Address"}}</option><option value="hours">{{index .Copy "Opening hours"}}</option></select><span class="help">{{index .Copy "For hours, use e.g. Mo-Fr 09:00-18:00; Sa 10:00-14:00"}}</span></label><label>{{index .Copy "Corrected value"}}<input type="text" name="proposed_value" maxlength="255" required></label><button class="btn btn-sm" type="submit">{{index .Copy "Suggest correction"}}</button></form></details>{{end}}<p class="muted u-text-sm">{{index .Copy "Corrections need a few independent confirmations before they show. We never change the map's own data, and never show who suggested or confirmed."}}</p></div>
{{if $p.CanContribute}}<div class="card"><h2 class="u-mt-0">{{index .Copy "Is this place gone?"}}</h2><p class="muted activity-meta-note">{{index .Copy "If this venue is demolished or permanently closed, let us know. If enough people agree, we'll stop sending groups here."}}</p><form method="post" action="{{$p.ClosureURL}}" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="btn btn--light" type="submit">{{index .Copy "Report: this venue is gone"}}</button></form>{{if .Staff}}<form method="post" action="{{$p.ClosureResetURL}}" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="btn btn--light" type="submit">{{index .Copy "Clear closure reports (staff)"}}</button></form>{{end}}</div>{{else if .Staff}}<div class="card"><form method="post" action="{{$p.ClosureResetURL}}" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="btn btn--light" type="submit">{{index .Copy "Clear closure reports (staff)"}}</button></form></div>{{end}}
{{template "public-share" $p.Share}}
{{if or $p.CityURL $p.Related}}<nav class="muted place-explore" aria-label="{{index .Copy "Explore"}}">{{if $p.Related}}<p>{{index .Copy "Find more to do here:"}} {{range $i, $link := $p.Related}}{{if $i}} · {{end}}<a href="{{$link.URL}}">{{$link.Label}}</a>{{end}}</p>{{end}}{{if $p.CityURL}}<p><a href="{{$p.CityURL}}">{{$p.CityNote}}</a></p>{{end}}</nav>{{end}}</details>
{{end}}
{{define "public-place-activity"}}<div class="card activity-card">{{if .Accent}}{{if .PhotoURL}}<figure class="card-visual card-visual--photo"><img src="{{.PhotoURL}}" alt="{{.PhotoAlt}}" loading="lazy" decoding="async"></figure>{{else}}<div class="card-visual card-accent" aria-hidden="true">{{.AccentSVG}}</div>{{end}}{{end}}<div class="activity-card-body">{{if .Reason}}<span class="score">{{.Reason}}</span>{{else if .Match}}<span class="score">{{.Match}}</span>{{end}}<h3><a href="{{.URL}}">{{.Title}}</a></h3><div><span class="tag">{{.Type}}</span>{{range .Secondary}}<span class="tag tag-muted">{{.}}</span>{{end}}{{if .Cost}}<span class="tag">{{.Cost}}</span>{{end}}{{if .Difficulty}}<span class="tag">{{.Difficulty}}</span>{{end}}{{if .Beginners}}<span class="tag">{{.BeginnersText}}</span>{{end}}{{if .Status}}<span class="tag">{{.Status}}</span>{{end}}{{if .Guardian}}<span class="tag">{{.GuardianText}}</span>{{end}}</div><p class="muted">{{.When}} · {{.Place}}{{if .City}}, {{.City}}{{end}}{{if .Distance}} · {{.Distance}}{{end}}</p>{{if .Description}}<p class="card-desc">{{.Description}}</p>{{end}}</div></div>{{end}}
{{define "public-place-image-fields"}}{{if .Errors}}<p class="error" role="alert">{{.Errors}}</p>{{end}}{{range .Fields}}<p><label for="id_{{.Name}}">{{.Label}}</label><input id="id_{{.Name}}" type="{{.Type}}" name="{{.Name}}"{{if ne .Type "file"}} value="{{.Value}}"{{end}}{{if .Required}} required{{end}}{{if .Checked}} checked{{end}}{{if .MaxLength}} maxlength="{{.MaxLength}}"{{end}}{{if .Help}} aria-describedby="help_{{.Name}}"{{end}}>{{if .Help}}<span id="help_{{.Name}}" class="helptext">{{.Help}}</span>{{end}}</p>{{end}}{{end}}
