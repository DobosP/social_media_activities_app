{{define "account-center"}}<!doctype html>
<html lang="{{.Shell.Language}}" data-theme="{{.Shell.Theme}}" data-text="{{.Shell.Text}}" data-motion="{{.Shell.Motion}}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow">
<title>{{.Title}} · {{.Shell.SiteName}}</title><link rel="canonical" href="{{.Shell.Canonical}}">
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/css/base.css"><link rel="stylesheet" href="/static/css/account-center-native.css"></head>
<body class="account-center-native has-tabbar">
<a class="skip-link" href="#main">{{index .Copy "Skip to main content"}}</a>
<header class="site-header"><div class="container nav-wrap"><a class="brand" href="/">{{index .Copy "Activities"}}</a>
<input type="checkbox" id="nav-toggle" class="nav-toggle-cb"><label for="nav-toggle" class="nav-toggle"><span aria-hidden="true">☰</span> {{index .Copy "Menu"}}</label>
<nav class="nav" aria-label="{{index .Copy "Primary"}}">{{range .Shell.Navigation}}<a class="nav-link" href="{{.URL}}">{{.Label}}</a>{{end}}</nav>
<details class="nav-menu nav-end"><summary>{{if .Avatar}}<img class="avatar nav-avatar" src="{{.Avatar}}" width="26" height="26" alt="">{{end}}<span class="nav-username">{{.Shell.DisplayName}}</span></summary><div class="nav-panel">
{{range .AccountLinks}}<a href="{{.URL}}">{{.Label}}</a>{{end}}
<form method="post" action="/logout/" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="linkbtn" type="submit">{{index .Copy "Log out"}}</button></form>
</div></details></div></header>
<main class="container" id="main" tabindex="-1"><h1>{{.Title}}</h1>
<nav class="tabs" aria-label="{{index .Copy "Account"}}">{{range .Shell.AccountTabs}}<a href="{{.URL}}"{{if .Current}} class="is-active" aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav>
{{if .Messages}}<ul class="messages">{{range .Messages}}<li class="msg {{.Tags}}"><span role="status">{{.Text}}</span></li>{{end}}</ul>{{end}}
{{if not .Settings}}<p class="muted">{{.SignedBefore}}<strong>{{.Shell.DisplayName}}</strong>{{.SignedAfter}}</p>{{end}}
<div class="account-center-grid">
{{if .Settings}}<section class="card"><h2>{{index .Copy "Language"}}</h2><p class="muted">{{index .Copy "Choose the language this site is shown in."}}</p>
<form method="post" action="/i18n/setlang/" class="row"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><input type="hidden" name="next" value="{{.LanguageNext}}">
<label for="account-center-language">{{index .Copy "Language"}}</label><select id="account-center-language" name="language"><option value="en"{{if .Shell.English}} selected{{end}}>English</option><option value="ro"{{if not .Shell.English}} selected{{end}}>Română</option></select><button class="btn btn-sm" type="submit">{{index .Copy "Save"}}</button></form></section>{{end}}
{{range .Groups}}<section class="card"><h2>{{.Heading}}</h2><div class="stack">{{range .Links}}<a href="{{.URL}}">{{.Label}}</a>{{end}}</div></section>{{end}}
{{if .Settings}}<section class="card" data-account-token-record="{{.HasToken}}"><h2>{{index .Copy "API access"}}</h2>
{{if .HasToken}}<p class="muted">{{.TokenText}}</p><form method="post" action="/settings/api-token/revoke/" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="btn btn-sm btn-secondary" type="submit">{{index .Copy "Revoke API access"}}</button></form>
{{else}}<p class="muted">{{index .Copy "No device currently holds API access to your account."}}</p>{{end}}</section>
<section class="card card-danger"><h2>{{index .Copy "Your account"}}</h2><p class="muted">{{index .Copy "Your data belongs to you. Take a copy any time, or delete the account and the personal data that goes with it."}}</p><div class="row"><a class="btn btn-secondary" href="/account/export/">{{index .Copy "Download my data"}}</a><a class="btn btn-danger" href="/account/delete/">{{index .Copy "Delete my account"}}</a></div></section>{{end}}
</div><form method="post" action="/logout/" class="inline account-center-logout"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="btn btn-secondary" type="submit">{{index .Copy "Log out"}}</button></form></main>
<nav class="tabbar" aria-label="{{index .Copy "Menu"}}"><a href="/">{{index .Copy "Home"}}</a><a href="/activities/">{{index .Copy "Browse"}}</a><a class="tab-cta" href="/activities/new/">{{index .Copy "Organize"}}</a><a href="/messages/">Chat</a><a href="/you/">{{index .Copy "Profile"}}</a></nav>
<footer class="site-footer"><div class="container"><p><strong>{{index .Copy "Demo environment: do not enter real personal data."}}</strong></p>
<nav class="footer-links" aria-label="{{index .Copy "Privacy"}}">{{range .Shell.Footer}}<a href="{{.URL}}">{{.Label}}</a> {{end}}</nav>
<form method="post" action="/i18n/setlang/" class="inline lang-switch"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><input type="hidden" name="next" value="{{.LanguageNext}}"><label for="account-center-footer-language">{{index .Copy "Language"}}</label><select id="account-center-footer-language" name="language" data-auto-submit><option value="en"{{if .Shell.English}} selected{{end}}>English</option><option value="ro"{{if not .Shell.English}} selected{{end}}>Română</option></select><noscript><button class="linkbtn" type="submit">{{index .Copy "Set language"}}</button></noscript></form>
</div></footer>
<script nonce="{{.Nonce}}" src="/static/js/hovercard.js" defer></script><script nonce="{{.Nonce}}" id="site-js" src="/static/js/site.js" defer data-meetups-owner="{{.PublicID}}"></script>
</body></html>{{end}}
