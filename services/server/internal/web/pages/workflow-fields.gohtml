{{define "workflow-field"}}<div class="form-field">{{if .Errors}}<p class="errorlist" role="alert">{{.Errors}}</p>{{end}}{{if ne .Type "hidden"}}<label for="id_{{.Name}}">{{.Label}}</label>{{end}}
{{if eq .Type "select"}}<select id="id_{{.Name}}" name="{{.Name}}"{{if .Required}} required{{end}}{{if .Disabled}} disabled{{end}}{{if .Multiple}} multiple data-combobox="multiple" data-combobox-max="2"{{else if .Combo}} data-combobox="{{.Combo}}"{{end}}>{{range .Options}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>
{{else if eq .Type "textarea"}}<textarea id="id_{{.Name}}" name="{{.Name}}"{{if .Required}} required{{end}}{{if .MaxLength}} maxlength="{{.MaxLength}}"{{end}}{{if .MinLength}} minlength="{{.MinLength}}"{{end}}>{{.Value}}</textarea>
{{else}}<input type="{{.Type}}" id="id_{{.Name}}" name="{{.Name}}" value="{{.Value}}"{{if .Required}} required{{end}}{{if .Checked}} checked{{end}}{{if .MaxLength}} maxlength="{{.MaxLength}}"{{end}}{{if .MinLength}} minlength="{{.MinLength}}"{{end}}{{if .Cost}} step="0.01" min="0"{{end}}>{{end}}
{{if .Help}}<div class="helptext">{{.Help}}</div>{{end}}</div>{{end}}
{{define "workflow-fields"}}{{if .Errors}}<p class="errorlist" role="alert">{{.Errors}}</p>{{end}}{{if .NonFieldErrors}}<p class="errorlist" role="alert">{{.NonFieldErrors}}</p>{{end}}{{range .Fields}}{{template "workflow-field" .}}{{end}}{{end}}
