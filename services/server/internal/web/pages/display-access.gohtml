{{define "display-access"}}<!doctype html>
<html lang="{{.Shell.Language}}" data-theme="{{.Shell.Theme}}" data-text="{{.Shell.Text}}" data-motion="{{.Shell.Motion}}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="index, follow">
<title>{{.Title}} · {{.Shell.SiteName}}</title><link rel="canonical" href="{{.Shell.Canonical}}">
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/css/base.css"><link rel="stylesheet" href="/static/css/display-access-native.css"></head>
<body class="display-access-native{{if .Authenticated}} has-tabbar{{end}}">
<a class="skip-link" href="#main">{{index .Copy "Skip to main content"}}</a>
<header class="site-header"><div class="container nav-wrap"><a class="brand" href="/">{{index .Copy "Activities"}}</a>
<input type="checkbox" id="nav-toggle" class="nav-toggle-cb"><label for="nav-toggle" class="nav-toggle"><span aria-hidden="true">☰</span> {{index .Copy "Menu"}}</label>
<nav class="nav" aria-label="{{index .Copy "Primary"}}">{{range .Shell.Navigation}}<a class="nav-link" href="{{.URL}}">{{.Label}}</a>{{end}}</nav>
{{if .Authenticated}}<details class="nav-menu nav-end"><summary>{{if .Avatar}}<img class="avatar nav-avatar" src="{{.Avatar}}" width="26" height="26" alt="">{{end}}<span class="nav-username">{{.Shell.DisplayName}}</span></summary><div class="nav-panel">
{{range .AccountLinks}}<a href="{{.URL}}">{{.Label}}</a>{{end}}<form method="post" action="/logout/" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="linkbtn" type="submit">{{index .Copy "Log out"}}</button></form>
</div></details>{{else}}<div class="row"><a class="nav-link" href="/login/">{{index .Copy "Log in"}}</a><a class="btn" href="/register/">{{index .Copy "Sign up"}}</a></div>{{end}}</div></header>
<main class="container" id="main" tabindex="-1"><h1>{{.Title}}</h1>
{{if .Shell.AccountTabs}}<nav class="tabs" aria-label="{{index .Copy "Account"}}">{{range .Shell.AccountTabs}}<a href="{{.URL}}"{{if .Current}} class="is-active" aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav>{{end}}
{{if .Messages}}<ul class="messages">{{range .Messages}}<li class="msg {{.Tags}}"><span role="status">{{.Text}}</span></li>{{end}}</ul>{{end}}
<p class="muted display-access-intro">{{.Intro}}</p>
{{if .Display}}<form method="post" action="/display/" class="display-access-form"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}">
<div class="display-access-grid">{{range .Groups}}<fieldset class="card"><legend><strong>{{.Legend}}</strong></legend>{{$name := .Name}}{{range .Options}}<label class="row preference-choice"><input type="radio" name="{{$name}}" value="{{.Value}}"{{if .Selected}} checked{{end}}><span>{{.Label}}</span></label>{{end}}</fieldset>{{end}}</div>
<button class="btn preference-submit" type="submit">{{index .Copy "Save display settings"}}</button></form>
{{else}}<form method="post" class="card display-access-form"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}">
{{range .Access}}<label class="row preference-choice"><input type="checkbox" name="{{.Name}}"{{if .Checked}} checked{{end}}><span><strong>{{.Label}}</strong>{{if .Detail}}<br><span class="muted u-text-sm">{{.Detail}}</span>{{end}}</span></label>{{end}}
<button class="btn preference-submit" type="submit">{{index .Copy "Save preferences"}}</button></form>{{end}}</main>
{{if .Authenticated}}<nav class="tabbar" aria-label="{{index .Copy "Menu"}}"><a href="/">{{index .Copy "Home"}}</a><a href="/activities/">{{index .Copy "Browse"}}</a><a class="tab-cta" href="/activities/new/">{{index .Copy "Organize"}}</a><a href="/messages/">Chat</a><a href="/you/">{{index .Copy "Profile"}}</a></nav>{{end}}
<footer class="site-footer"><div class="container"><p><strong>{{index .Copy "Demo environment: do not enter real personal data."}}</strong></p>
<nav class="footer-links" aria-label="{{index .Copy "Privacy"}}">{{range .Shell.Footer}}<a href="{{.URL}}">{{.Label}}</a> {{end}}</nav>
<form method="post" action="/i18n/setlang/" class="inline lang-switch"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><input type="hidden" name="next" value="{{.LanguageNext}}"><label for="display-access-language">{{index .Copy "Language"}}</label><select id="display-access-language" name="language" data-auto-submit><option value="en"{{if .Shell.English}} selected{{end}}>English</option><option value="ro"{{if not .Shell.English}} selected{{end}}>Română</option></select><noscript><button class="linkbtn" type="submit">{{index .Copy "Set language"}}</button></noscript></form>
</div></footer><script nonce="{{.Nonce}}" src="/static/js/hovercard.js" defer></script><script nonce="{{.Nonce}}" id="site-js" src="/static/js/site.js" defer data-meetups-owner="{{.PublicID}}"></script></body></html>{{end}}
