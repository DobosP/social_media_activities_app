{{define "group-detail-post"}}{{$post := .}}
<article id="post-{{.ID}}" data-author="{{.AuthorID}}" class="post{{if .Mine}} post--mine{{end}}" aria-label="{{.Aria}}">
{{if .Snippet}}<div class="reply-quote muted"><a href="#post-{{.Snippet.ID}}">{{.Snippet.Label}}</a>: {{.Snippet.Text}}</div>{{end}}
<div class="meta"><img class="avatar avatar-xs" src="{{.Author.Avatar}}" width="20" height="20" alt=""><span class="author">{{if .Author.Other}}<a href="{{.Author.ProfileURL}}" data-hovercard-user="{{.Author.PublicID}}">{{.Author.Name}}</a>{{else}}{{.Author.Name}}{{end}}</span> · <a href="#post-{{.ID}}" class="muted" title="{{index .Copy "Link to this message"}}"><time datetime="{{.ISOTime}}">{{.When}}</time></a>{{if .Edited}}<span class="muted edited-mark">{{index .Copy "(edited)"}}</span>{{end}}</div>
<div>{{if .BodyHTML}}{{.BodyHTML}}{{else}}{{range $i,$line := .Lines}}{{if $i}}<br>{{end}}{{$line}}{{end}}{{end}}</div>
{{if .Share}}{{if eq .Share.Kind "gone"}}<p class="share-card share-card--gone muted">{{index .Copy "This shared item is no longer available."}}</p>{{else}}<a class="share-card" href="{{.Share.URL}}"><span class="share-kind">{{if eq .Share.Kind "activity"}}{{index .Copy "Activity"}}{{else if eq .Share.Kind "place"}}📍 {{index .Copy "Place"}}{{else}}{{index .Copy "Event"}}{{end}}</span><strong>{{.Share.Title}}</strong>{{if or .Share.When .Share.Place}}<span class="muted">{{.Share.When}}{{if and .Share.When .Share.Place}} · {{end}}{{.Share.Place}}</span>{{end}}</a>{{end}}{{end}}
<div class="post-media">{{range .Media}}
{{if .Blocked}}<p class="muted post-attachment-note">🛑 {{index $post.Copy "Blocked by safety screening — evidence retained for moderation."}}</p>
{{else if .Processing}}<p class="muted post-attachment-note">🎬 {{index $post.Copy "Video is being prepared — it will appear here shortly."}}</p>
{{else if .Failed}}<p class="muted post-attachment-note">🎬 {{index $post.Copy "This video couldn't be processed."}}</p>
{{else if .Expired}}<p class="muted post-attachment-note">🕓 {{index $post.Copy "This temporary picture has disappeared."}}</p>
{{else if eq .Kind "image"}}<a href="{{.URL}}" target="_blank" rel="noopener noreferrer"><img class="post-attachment-img" src="{{.Thumb}}" alt="{{index $post.Copy "shared image"}}" loading="lazy"></a>{{if .Expiry}}<p class="muted post-attachment-expiry">🕓 {{.Expiry}}</p>{{end}}
{{else if eq .Kind "video"}}<video class="post-attachment-video" controls preload="metadata" playsinline{{if .Poster}} poster="{{.Poster}}"{{end}} src="{{.URL}}"></video>{{if .Expiry}}<p class="muted post-attachment-expiry">🕓 {{.Expiry}}</p>{{end}}
{{else}}<p class="post-pdf">📎 <a href="{{.URL}}">{{.Filename}}</a> <span class="muted small-copy">{{index $post.Copy "(PDF &mdash; downloads)"}}</span>{{if .Expiry}}<span class="muted tiny-copy"> · 🕓 {{.Expiry}}</span>{{end}}</p>{{end}}
{{end}}</div>
{{range .Sentiment}}<p class="sentiment-line">{{.}}</p>{{end}}
<div class="rx">{{if .Member}}
<details class="rx-pick"><summary class="muted">{{index .Copy "react"}}</summary>{{range .Facets}}<form method="post" action="{{$post.ReactURL}}" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{$post.CSRF}}"><input type="hidden" name="emoji" value="{{.Slug}}"><button class="rx-btn{{if .Mine}} rx-mine{{end}}" type="submit" data-slug="{{.Slug}}" aria-label="{{.Aria}}">{{.Emoji}} {{.Label}}</button></form>{{end}}</details>
<details class="respond-menu"><summary class="muted">{{index .Copy "Respond"}}</summary>
{{if .DissentControls}}
<div class="dissent-row"><div class="row respond-row-actions"><a class="btn btn-sm" href="{{.ReplyURL}}">{{index .Copy "Reply with your view"}}</a><form method="post" action="{{.DissentURL}}" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.CSRF}}"><button class="btn btn-sm btn-secondary dissent-toggle" type="submit" data-label-on="{{index .Copy "Noted quietly — tap to withdraw"}}" data-label-off="{{index .Copy "Quietly note \"I see this differently\""}}">{{if .Dissent}}{{index .Copy "Noted quietly — tap to withdraw"}}{{else}}{{index .Copy "Quietly note \"I see this differently\""}}{{end}}</button></form></div><p class="muted dissent-after-hint"{{if not .Dissent}} hidden{{end}}>{{index .Copy "Want to say why? Reply."}}</p><p class="muted small-print dissent-privacy">{{index .Copy "A quiet note is never shown with names or numbers — not even to the writer."}}</p></div>
<div class="concern-row"><div class="concern-intro muted">{{.ConcernIntro}}</div><form method="post" action="{{.ConcernURL}}" class="inline concern-form"><input type="hidden" name="csrfmiddlewaretoken" value="{{.CSRF}}"><button class="btn btn-sm concern-toggle" type="submit"{{if .Concern}} data-concerned="1"{{end}} data-label-send="{{index .Copy "Send"}}" data-label-collapsed="{{index .Copy "This doesn't seem to fit here"}}" data-label-withdraw="{{index .Copy "Marked — tap to withdraw"}}">{{if .Concern}}{{index .Copy "Marked — tap to withdraw"}}{{else}}{{index .Copy "Send"}}{{end}}</button></form><p class="muted small-print concern-subtitle">{{index .Copy "For off-topic posts — never public; the writer only hears about it if a few others feel the same. Disagree instead? Use 'I see this differently'."}}</p></div>
{{end}}
<div class="respond-divider">{{if .Author.Other}}<a class="muted u-text-xs report-link" href="{{.ReportURL}}">{{index .Copy "Report"}}</a>{{end}}</div>
</details>{{end}}</div>
{{if .Member}}<div class="post-actions"><a href="{{.ReplyURL}}">{{index .Copy "Reply"}}</a>{{if .Mine}} · <a href="#edit-{{.ID}}">{{index .Copy "Edit"}}</a> · <form method="post" action="{{.DeleteURL}}" class="inline" data-confirm="{{index .Copy "Delete your message? This can't be undone."}}"><input type="hidden" name="csrfmiddlewaretoken" value="{{.CSRF}}"><button class="linkbtn" type="submit">{{index .Copy "Delete"}}</button></form><form method="post" id="edit-{{.ID}}" class="post-edit" action="{{.EditURL}}"><input type="hidden" name="csrfmiddlewaretoken" value="{{.CSRF}}"><textarea name="body" rows="2" maxlength="4000" required aria-label="{{index .Copy "Edit your message"}}">{{.Body}}</textarea><button class="btn btn-sm" type="submit">{{index .Copy "Save edit"}}</button></form>{{end}}</div>{{end}}
</article>{{end}}
