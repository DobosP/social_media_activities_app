{{define "group-detail-card"}}<div class="card activity-card">
{{if .Accent}}{{if .PhotoURL}}<figure class="card-visual card-visual--photo"><img src="{{.PhotoURL}}" alt="{{.PhotoAlt}}" loading="lazy" decoding="async"></figure>{{else}}<div class="card-visual card-accent" aria-hidden="true">{{.AccentSVG}}</div>{{end}}{{end}}
<div class="activity-card-body">{{if .Reason}}<span class="score">{{.Reason}}</span>{{else if .Match}}<span class="score">{{.Match}}</span>{{end}}<h3><a href="{{.URL}}">{{.Title}}</a></h3><div><span class="tag">{{.Type}}</span>{{range .Secondary}}<span class="tag tag-muted">{{.}}</span>{{end}}{{if .Cost}}<span class="tag">{{.Cost}}</span>{{end}}{{if .Difficulty}}<span class="tag">{{.Difficulty}}</span>{{end}}{{if .Beginners}}<span class="tag">{{.BeginnersText}}</span>{{end}}{{if .Status}}<span class="tag">{{.Status}}</span>{{end}}{{if .Guardian}}<span class="tag">{{.GuardianText}}</span>{{end}}</div><p class="muted">{{.When}} · {{.Place}}{{if .City}}, {{.City}}{{end}}{{if .Distance}} · {{.Distance}}{{end}}</p>{{if .Description}}<p class="card-desc">{{.Description}}</p>{{end}}</div>
</div>{{end}}
