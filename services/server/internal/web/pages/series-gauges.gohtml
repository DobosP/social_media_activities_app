{{define "series-gauges"}}<!doctype html>
<html lang="{{.Shell.Language}}" data-theme="{{.Shell.Theme}}" data-text="{{.Shell.Text}}" data-motion="{{.Shell.Motion}}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow"><title>{{.Title}} · {{.Shell.SiteName}}</title><link rel="canonical" href="{{.Shell.Canonical}}">
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/static/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/css/base.css"><link rel="stylesheet" href="/static/css/series-gauges-native.css"><link rel="stylesheet" href="/static/css/completion-accessibility.css"></head>
<body class="series-gauges-native has-tabbar"><a class="skip-link" href="#main">{{index .Copy "Skip to main content"}}</a>
<header class="site-header"><div class="container nav-wrap"><a class="brand" href="/">{{index .Copy "Activities"}}</a><input type="checkbox" id="nav-toggle" class="nav-toggle-cb"><label for="nav-toggle" class="nav-toggle"><span aria-hidden="true">☰</span> {{index .Copy "Menu"}}</label>
<nav class="nav" aria-label="{{index .Copy "Primary"}}">{{range .Shell.Navigation}}<a class="nav-link" href="{{.URL}}">{{.Label}}{{if and (eq .URL "/notifications/") $.Unread}} <span class="pill">{{$.Unread}}</span>{{end}}</a>{{end}}</nav>
<details class="nav-menu nav-end"><summary>{{if .Avatar}}<img class="avatar nav-avatar" src="{{.Avatar}}" width="26" height="26" alt="">{{end}}<span class="nav-username">{{.Shell.DisplayName}}</span></summary><div class="nav-panel">{{range .AccountLinks}}<a href="{{.URL}}">{{.Label}}</a>{{end}}<form method="post" action="/logout/" class="inline"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><button class="linkbtn" type="submit">{{index .Copy "Log out"}}</button></form></div></details></div></header>
<main class="container" id="main" tabindex="-1">{{if .BackURL}}<p class="muted"><a href="{{.BackURL}}">← {{.BackLabel}}</a></p>{{end}}<h1>{{.Title}}</h1>
{{if .Messages}}<ul class="messages">{{range .Messages}}<li class="msg {{.Tags}}"><span role="status">{{.Text}}</span></li>{{end}}</ul>{{end}}
{{if .Intro}}<p class="muted series-gauges-intro">{{.Intro}}</p>{{end}}
{{if .SeriesList}}<p><a class="btn" href="{{.CreateURL}}">{{.CreateLabel}}</a></p><div class="series-gauges-grid">{{range .Series}}<article class="card"><h2><a href="{{.URL}}">{{.Title}}</a></h2><div class="cluster"><span class="tag">{{.Activity}}</span><span class="tag">{{.Cadence}}</span><span class="tag">{{.StatusLabel}}</span></div><p class="muted">{{.Place}}{{if .Active}} · {{.Next}}{{end}}</p></article>{{else}}<p class="muted">{{index .Copy "You haven't set up any recurring series yet."}} <a href="{{.CreateURL}}">{{index .Copy "Create one?"}}</a></p>{{end}}</div>{{end}}
{{if .SeriesDetail}}<div class="cluster"><span class="tag">{{.CurrentSeries.Activity}}</span><span class="tag">{{.CurrentSeries.Cadence}}</span><span class="tag">{{.CurrentSeries.StatusLabel}}</span></div><p class="muted">{{.CurrentSeries.At}}{{if .CurrentSeries.Active}} {{.CurrentSeries.Next}}{{end}}</p>{{if .CurrentSeries.Description}}<p class="series-gauges-prose">{{.CurrentSeries.Description}}</p>{{end}}
{{if .Owner}}<section class="card card-accent"><h2>{{index .Copy "Series controls"}}</h2><p class="muted">{{index .Copy "Pausing stops new meetups from being scheduled; ending is permanent. Meetups already scheduled always stand."}}</p><div class="row">{{range .Actions}}<form method="post" action="{{.URL}}"{{if .Confirm}} data-confirm="{{.Confirm}}"{{end}}><input type="hidden" name="csrfmiddlewaretoken" value="{{$.Shell.CSRF}}"><button class="btn btn-sm btn-secondary" type="submit">{{.Label}}</button></form>{{end}}</div>
{{if .ShowNextNote}}<form method="post" action="{{.NextNoteURL}}" class="series-gauges-form"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}">{{template "series-gauges-fields" .NextNote}}<p class="muted">{{index .Copy "Added to the next scheduled meetup's organiser note, then cleared automatically. Leave blank to clear."}}</p><button class="btn btn-sm" type="submit">{{index .Copy "Save heads-up"}}</button></form>{{end}}</section>{{end}}
<section><h2>{{index .Copy "Scheduled meetups"}}</h2><div class="series-gauges-grid">{{range .Instances}}<article class="card"><h3><a href="{{.URL}}">{{.Title}}</a></h3><p class="muted">{{.When}} · {{.Status}}</p></article>{{else}}<p class="muted">{{index .Copy "No meetups scheduled yet &mdash; the next one appears automatically before it starts."}}</p>{{end}}</div></section>{{end}}
{{if .GaugeList}}<p><a class="btn btn-sm" href="{{.CreateURL}}">{{.CreateLabel}}</a></p><div class="series-gauges-grid">{{range .Gauges}}<article class="card"><h2><a href="{{.URL}}">{{.Activity}} {{.At}}</a></h2><p class="muted">{{.Window}} · {{if .Ready}}{{index $.Copy "ready to start"}}{{else}}{{.Readiness}}{{end}}</p></article>{{else}}<p class="muted">{{index .Copy "No open gauges right now &mdash; start one above."}}</p>{{end}}</div>{{end}}
{{if .GaugeDetail}}<p class="muted">{{.CurrentGauge.Window}}{{if .CurrentGauge.City}} · {{.CurrentGauge.City}}{{end}}</p><section class="card card-accent"><h2>{{if .CurrentGauge.Ready}}{{index .Copy "Ready to start"}}{{else}}{{.CurrentGauge.Readiness}}{{end}}</h2>{{if .CurrentGauge.Ready}}<p>{{index .Copy "Enough people are interested to start this as a real meetup."}}</p>{{end}}</section>
{{if .Proposer}}<p class="muted">{{index .Copy "You started this gauge."}}</p><p><a class="btn" href="{{.CreateURL}}">{{.CreateLabel}}</a></p>{{else}}{{range .Actions}}<form method="post" action="{{.URL}}"><input type="hidden" name="csrfmiddlewaretoken" value="{{$.Shell.CSRF}}"><button class="btn" type="submit">{{.Label}}</button></form>{{end}}{{end}}<p class="muted series-gauges-after">{{index .Copy "Temporary: this gauge expires on its own if it isn't converted."}}</p>{{end}}
{{if .ShowForm}}<form method="post" class="card series-gauges-form"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}">{{template "series-gauges-fields" .Form}}<button class="btn" type="submit">{{.Submit}}</button></form>{{end}}</main>
<nav class="tabbar" aria-label="{{index .Copy "Menu"}}"><a href="/">{{index .Copy "Home"}}</a><a href="/activities/">{{index .Copy "Browse"}}</a><a class="tab-cta" href="/activities/new/">{{index .Copy "Organize"}}</a><a href="/messages/">Chat</a><a href="/you/">{{index .Copy "Profile"}}</a></nav>
<footer class="site-footer"><div class="container"><p><strong>{{index .Copy "Demo environment: do not enter real personal data."}}</strong></p><nav class="footer-links" aria-label="{{index .Copy "Privacy"}}">{{range .Shell.Footer}}<a href="{{.URL}}">{{.Label}}</a> {{end}}</nav>
<form method="post" action="/i18n/setlang/" class="inline lang-switch"><input type="hidden" name="csrfmiddlewaretoken" value="{{.Shell.CSRF}}"><input type="hidden" name="next" value="{{.LanguageNext}}"><label for="series-gauges-language">{{index .Copy "Language"}}</label><select id="series-gauges-language" name="language" data-auto-submit><option value="en"{{if .Shell.English}} selected{{end}}>English</option><option value="ro"{{if not .Shell.English}} selected{{end}}>Română</option></select><noscript><button class="linkbtn" type="submit">{{index .Copy "Set language"}}</button></noscript></form></div></footer>
<script nonce="{{.Nonce}}" src="/static/js/hovercard.js" defer></script><script nonce="{{.Nonce}}" id="site-js" src="/static/js/site.js" defer data-meetups-owner="{{.PublicID}}"></script></body></html>{{end}}
{{define "series-gauges-fields"}}{{if .Error}}<p class="msg" role="alert">{{.Error}}</p>{{end}}{{range .Fields}}<div class="series-gauges-field"><label for="id_{{.Name}}">{{.Label}}</label>{{if .Select}}<select id="id_{{.Name}}" name="{{.Name}}"{{if .Required}} required{{end}}{{if .Combo}} data-combobox="single"{{end}}>{{range .Options}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>{{else if .Textarea}}<textarea id="id_{{.Name}}" name="{{.Name}}"{{if .Required}} required{{end}}{{if .MaxLength}} maxlength="{{.MaxLength}}"{{end}}{{if .MinLength}} minlength="{{.MinLength}}"{{end}}>{{.Value}}</textarea>{{else}}<input id="id_{{.Name}}" type="{{.Type}}" name="{{.Name}}" value="{{.Value}}"{{if .Required}} required{{end}}{{if .Checked}} checked{{end}}{{if .MaxLength}} maxlength="{{.MaxLength}}"{{end}}{{if .MinLength}} minlength="{{.MinLength}}"{{end}}{{if eq .Name "cost_amount"}} step="0.01" min="0"{{end}}>{{end}}{{if .Help}}<p class="muted helptext">{{.Help}}</p>{{end}}</div>{{end}}{{end}}
