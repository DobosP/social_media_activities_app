{
  "NextInstanceNoteForm": {
    "next_instance_note": {
      "kind": "CharField",
      "required": false,
      "max_length": 500,
      "label": "Heads-up for the next meetup",
      "help_text": "Added to the next scheduled meetup's organiser note, then cleared.",
      "order": 1,
      "textarea": true
    }
  },
  "RegisterForm": {
    "username": {
      "kind": "CharField",
      "required": true,
      "max_length": 150,
      "order": 1
    },
    "display_name": {
      "kind": "CharField",
      "required": false,
      "max_length": 120,
      "order": 2
    },
    "password": {
      "kind": "CharField",
      "required": true,
      "min_length": 8,
      "order": 3
    },
    "age_band": {
      "kind": "ChoiceField",
      "required": true,
      "label": "Age (demo age assurance)",
      "help_text": "Stands in for the EU age-verification flow in this demo.",
      "order": 4
    }
  },
  "ActivityForm": {
    "place": {
      "kind": "ModelChoiceField",
      "required": true,
      "order": 1
    },
    "activity_type": {
      "kind": "ModelChoiceField",
